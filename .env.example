# Core runtime
RTPU_DEPLOY_ENV=development
PUBLIC_BASE_URL=http://localhost:5173
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
RTPU_SUPPORT_EMAIL=support@rosstaxprosoftwareco.com
RTPU_MAINTENANCE_MODE=false

# Andreaa Channel
ANDREAA_CHANNEL_ENABLED=true
ANDREAA_INTERNAL_LIMIT_MULTIPLIER=10
ANDREAA_PRODUCTION_URL=https://rosstaxprouniversity.onrender.com

# Operations controls
OPS_ADMIN_KEY=
RTPU_CLASSROOM_INTEGRATION_KEY=

# Google Classroom OAuth/API
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:8787/api/integrations/google-classroom/oauth/callback
GOOGLE_CLASSROOM_REFRESH_TOKEN=
GOOGLE_CLASSROOM_OAUTH_STATE_SECRET=
GOOGLE_CLASSROOM_ACCESS_TOKEN=
GOOGLE_CLASSROOM_BASE_URL=https://classroom.googleapis.com/v1

# Optional provider capability flags
ANDREAA_DEEP_THINK_ENABLED=false
ANDREAA_IMAGE_ENABLED=false
ANDREAA_VIDEO_ENABLED=false
ANDREAA_MUSIC_ENABLED=false
ANDREAA_FLOW_ENABLED=false
ANDREAA_ANTIGRAVITY_ENABLED=false
ANDREAA_JULES_ENABLED=false

# Optional LMS adapters
LMS_CANVAS_ENABLED=false
CANVAS_API_BASE_URL=
CANVAS_ACCESS_TOKEN=
LMS_MOODLE_ENABLED=false
MOODLE_API_BASE_URL=
MOODLE_TOKEN=
LMS_BLACKBOARD_ENABLED=false
BLACKBOARD_API_BASE_URL=
BLACKBOARD_CLIENT_ID=
BLACKBOARD_CLIENT_SECRET=

# Optional deployment automation
RENDER_DEPLOY_HOOK_URL=
