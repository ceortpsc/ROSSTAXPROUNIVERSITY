{
  "platform": "Texas Ross Tax Pro Software Co. University of Accounting & Taxation",
  "status": "pre-authorization workflow",
  "purpose": "Governed navigation and evidence workflow for proposed certificates, diplomas and degrees.",
  "objectiveGate": {
    "entry": "/credentials",
    "requiredChecks": [
      "student_identity_verified",
      "active_enrollment_verified",
      "program_version_verified",
      "catalog_requirements_verified",
      "credit_or_program_requirements_verified",
      "required_courses_completed",
      "assessments_verified",
      "academic_integrity_reviewed",
      "financial_or_account_status_checked",
      "institutional_authorization_evidence_verified",
      "program_approval_evidence_verified"
    ],
    "humanApprovalRequired": true,
    "aiMayAssist": true,
    "aiMayNotAwardCredential": true
  },
  "workflow": [
    "degree_audit",
    "evidence_collection",
    "registrar_review",
    "academic_review",
    "authorization_review",
    "authorized_human_approval",
    "credential_generation",
    "credential_registry_entry",
    "verification_record"
  ],
  "credentialTypes": ["certificate","diploma","associate","bachelor","master"],
  "disclosure": "Credential titles and degree awards remain subject to actual institutional, state and applicable federal authorization/approval. This configuration does not itself establish accreditation or degree-granting authority."
}
