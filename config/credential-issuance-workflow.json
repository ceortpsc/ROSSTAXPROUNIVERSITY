{
  "platform": "Ross Tax Pro University",
  "version": "2.0.0",
  "status": "governed-pre-issuance-workflow",
  "purpose": "Governed evidence and human-approval workflow for RTPU diplomas, certificates, transcripts, verifications and academic records.",
  "registries": {
    "artifacts": "config/credential-artifact-registry.json",
    "records": "config/credential-records-registry.json",
    "migration": "db/migrations/001_credential_records.sql",
    "queries": "db/queries/credential_records.sql",
    "openApi": "openapi/credential-records.openapi.yaml"
  },
  "objectiveGate": {
    "entry": "/records",
    "requiredChecks": [
      "student_identity_verified",
      "active_or_completed_enrollment_verified",
      "program_version_verified",
      "catalog_requirements_verified",
      "credit_or_program_requirements_verified",
      "required_courses_completed",
      "assessments_or_capstone_verified_if_applicable",
      "academic_integrity_reviewed",
      "credential_blocking_holds_clear",
      "institutional_authority_statements_verified_when_applicable",
      "program_authority_statements_verified_when_applicable",
      "authorized_human_approval_recorded"
    ],
    "humanApprovalRequired": true,
    "aiMayAssist": true,
    "aiMayDraftDocument": true,
    "aiMayNotAwardCredential": true,
    "aiMayNotMarkOfficialTranscriptIssued": true
  },
  "workflow": [
    "degree_audit",
    "evidence_collection",
    "registrar_review",
    "academic_review",
    "authorization_review",
    "authorized_human_approval",
    "document_draft_generation",
    "document_integrity_hash",
    "approved_for_issuance",
    "credential_or_transcript_issuance",
    "credential_registry_entry_if_applicable",
    "verification_record",
    "delivery_evidence",
    "audit_event"
  ],
  "documentTypes": [
    "diploma",
    "certificate",
    "completion-record",
    "honors-certificate",
    "official-transcript",
    "unofficial-transcript",
    "transfer-credit-evaluation",
    "degree-audit",
    "student-record-summary",
    "verification-letter",
    "request-form",
    "credential-verification-record",
    "registrar-cover-sheet",
    "prior-education-evaluation",
    "admission-decision-notice",
    "graduation-clearance-checklist"
  ],
  "issuanceStatuses": [
    "template-not-issued",
    "draft-generated",
    "pending-review",
    "approved-for-issuance",
    "issued",
    "voided",
    "superseded"
  ],
  "disclosure": "Templates and workflow configuration do not themselves establish accreditation, degree-granting authority, government approval, professional licensure, IRS status or federal-aid eligibility. External authority claims must be independently verified before inclusion on an issued record."
}