{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ross Tax Pro University Analytics Event",
  "type": "object",
  "required": ["eventId", "eventType", "timestamp", "environment"],
  "properties": {
    "eventId": {"type": "string"},
    "eventType": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["development", "staging", "preview", "production"]},
    "actorRole": {"type": "string"},
    "route": {"type": "string"},
    "correlationId": {"type": "string"},
    "metrics": {"type": "object"},
    "sourceRef": {"type": "string"}
  },
  "additionalProperties": false
}
